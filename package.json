{
  "name": "@0sfs/fly",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "0SFS, the open-source flight simulator: the flight app, composed from the 0sfs aircraft, engine and feature repositories over FOSS Earth.",
  "repository": {
    "type": "git",
    "url": "https://github.com/0SFS/fly.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "llm-dev": "node scripts/dev.mjs --no-qr --no-gkey",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "npm run verify:jsbsim && npm run verify:audio && npm run verify:exhaust && npm run verify:engine-assets && npm run typecheck && vite build --configLoader native && node scripts/verify-jsbsim-artifact.mjs --dist=dist && node ../sound/scripts/verify-audio-artifact.mjs --dist=dist",
    "build:audio": "node ../sound/scripts/build-audio-wasm.mjs",
    "build:exhaust": "node ../F135/scripts/build-exhaust-optics.mjs --install",
    "check:phone-layout": "node ../rc/scripts/check-phone-layout.mjs",
    "check:aircraft-ui": "node ../aircraft/scripts/check-aircraft-selection-headless.mjs",
    "check:aircraft-switch": "node scripts/check-aircraft-switch-headless.mjs",
    "ci": "npm run lint && npm run test && npm run build",
    "deploy": "node ../0sfs.github.io/scripts/deploy.mjs flight",
    "prebuild": "node scripts/link-packs.mjs",
    "pretest": "node scripts/link-packs.mjs",
    "lint": "node scripts/lint.mjs",
    "preview": "vite preview --configLoader native",
    "typecheck": "tsc -p tsconfig.app.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.app.tsbuildinfo && tsc -p tsconfig.node.json --incremental --tsBuildInfoFile node_modules/.tmp/typecheck.node.tsbuildinfo",
    "test": "vitest run --configLoader native --passWithNoTests --maxWorkers=50%",
    "test:changed": "vitest related --run --configLoader native --passWithNoTests --maxWorkers=50%",
    "test:watch": "vitest --configLoader native",
    "verify:jsbsim": "node scripts/verify-jsbsim-artifact.mjs",
    "verify:audio": "node ../sound/scripts/verify-audio-artifact.mjs",
    "verify:exhaust": "node ../F135/scripts/build-exhaust-optics.mjs --check",
    "build:engine-assets": "node ../F135/scripts/build-f135-engine.mjs --install",
    "verify:engine-assets": "node ../F135/scripts/build-f135-engine.mjs --check",
    "model-override": "node scripts/model-override.mjs"
  },
  "dependencies": {
    "@0sfs/aircraft": "file:../aircraft",
    "@0sfs/anti-cheat": "file:../anti-cheat",
    "@0sfs/autopilot": "file:../autopilot",
    "@0sfs/c172": "file:../C172",
    "@0sfs/controls": "file:../controls",
    "@0sfs/engines": "file:../engines",
    "@0sfs/exhaust": "file:../exhaust",
    "@0sfs/f-35b": "file:../F-35B",
    "@0sfs/f135": "file:../F135",
    "@0sfs/fj33": "file:../FJ33",
    "@0sfs/fuel": "file:../fuel",
    "@0sfs/g-forces": "file:../g-forces",
    "@0sfs/ground-contact": "file:../ground-contact",
    "@0sfs/io320": "file:../IO320",
    "@0sfs/logging": "file:../logging",
    "@0sfs/logo": "file:../logo",
    "@0sfs/multiplayer": "file:../multiplayer",
    "@0sfs/rc": "file:../rc",
    "@0sfs/sf-50": "file:../SF-50",
    "@0sfs/sound": "file:../sound",
    "@0sfs/stores": "file:../stores",
    "@babylonjs/core": "8.56.2",
    "@babylonjs/loaders": "8.56.2",
    "@felipegalind0/gamepad-tools": "file:../../Felipegalind0/gamepad-tools",
    "@felipegalind0/jsbsim": "file:deps/felipegalind0-jsbsim-1.2.4-fork.21.tgz",
    "@foss-earth/renderer": "file:../../foss-earth/renderer",
    "@foss-earth/ui": "file:../../foss-earth/ui",
    "3d-tiles-renderer": "0.4.24",
    "foss-earth": "file:../../foss-earth/app",
    "jsqr": "1.4.0",
    "lucide-react": "1.41.0",
    "peerjs": "1.5.5",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.12.4",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@webgpu/types": "0.1.74",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.3.4",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
